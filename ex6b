if [[ $# -eq 0 ]]; then
read -rp "Enter numbers:" -a numbers
else
numbers=("$@")
fi
echo " ascending (a) or descending (d) order?"
read -r choice
n=${#numbers[@]}
for ((i=0; i<n-1; i++)); do
for ((j=0; j<n-i-1; j++)); do
if [[ "$choice" == "a" ]]; then
if (( numbers[j] > numbers[j+1] )); then
temp=${numbers[j]}
numbers[j]=${numbers[j+1]}
numbers[j+1]=$temp
fi
else
if (( numbers[j] < numbers[j+1] )); then
temp=${numbers[j]}
numbers[j]=${numbers[j+1]}
numbers[j+1]=$temp
fi
fi
done
done
echo "sorted numbers are: ${numbers[*]}"

 


